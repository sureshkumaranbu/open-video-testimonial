# Copy to .env and fill in. All values are read at runtime.

# Owner account for the admin dashboard (single-owner MVP).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-chars

# Public base URL of this instance (used in share links and embed snippets).
PUBLIC_URL=http://localhost:3000

# Where the SQLite database and uploaded media live. Mount this as a volume.
DATA_DIR=./data

# Upload limits (megabytes).
MAX_VIDEO_MB=200
MAX_IMAGE_MB=5

# Set to "true" when serving over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false

# --- Video processing -------------------------------------------------------
# With ffmpeg installed (it is in the Docker image), uploaded videos are
# converted to MP4 (H.264/AAC) that every browser plays, and get a poster
# image. Without it, videos are served exactly as uploaded.
# MEDIA_PROCESSING=off
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Background jobs ----------------------------------------------------------
# Video conversion, emails and webhooks run in a worker inside the server
# process. JOBS_WORKER=off disables it (nothing background will happen).
# JOBS_POLL_MS=2000

# --- Transcripts and captions --------------------------------------------------
# Off by default. Every video player shows captions once a transcript exists,
# and the owner can always type or paste captions (WebVTT or SRT) by hand.
#
# Option A: a local program, so no audio leaves your server (e.g. whisper.cpp).
#   {input} is a 16 kHz mono WAV file; the program must write {output}.vtt.
# TRANSCRIBE_PROVIDER=command
# TRANSCRIBE_COMMAND="/opt/whisper.cpp/build/bin/whisper-cli -m /opt/whisper.cpp/models/ggml-base.en.bin -f {input} -ovtt -of {output} -np"
#
# Option B: any OpenAI-compatible /audio/transcriptions endpoint. With OpenAI
# itself, the audio is sent to OpenAI; a self-hosted server keeps it local.
# TRANSCRIBE_PROVIDER=openai
# TRANSCRIBE_API_URL=https://api.openai.com/v1
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_LANGUAGE=en
