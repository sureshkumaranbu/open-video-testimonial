# Copy to .env and fill in. All values are read at runtime.

# Owner account for the admin dashboard (single-owner MVP).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-random-hex-chars

# Public base URL of this instance (used in share links and embed snippets).
PUBLIC_URL=http://localhost:3000

# Where the SQLite database and uploaded media live. Mount this as a volume.
DATA_DIR=./data

# Upload limits (megabytes).
MAX_VIDEO_MB=200
MAX_IMAGE_MB=5

# Set to "true" when serving over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=false

# Set to "true" when a reverse proxy (Caddy, nginx, Traefik…) sits in front of
# Plaudit and adds the visitor's address to X-Forwarded-For; use a number for
# several proxies in a row. Rate limits then key on the real visitor. Leave it
# false when Plaudit is reached directly, or anyone could fake their address.
TRUST_PROXY=false

# --- Video processing -------------------------------------------------------
# With ffmpeg installed (it is in the Docker image), uploaded videos are
# converted to MP4 (H.264/AAC) that every browser plays, and get a poster
# image. Without it, videos are served exactly as uploaded.
# MEDIA_PROCESSING=off
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# --- Background jobs ----------------------------------------------------------
# Video conversion, emails and webhooks run in a worker inside the server
# process. JOBS_WORKER=off disables it (nothing background will happen).
# JOBS_POLL_MS=2000

# --- Transcripts and captions --------------------------------------------------
# Off by default. Every video player shows captions once a transcript exists,
# and the owner can always type or paste captions (WebVTT or SRT) by hand.
#
# Option A: a local program, so no audio leaves your server (e.g. whisper.cpp).
#   {input} is a 16 kHz mono WAV file; the program must write {output}.vtt.
# TRANSCRIBE_PROVIDER=command
# TRANSCRIBE_COMMAND="/opt/whisper.cpp/build/bin/whisper-cli -m /opt/whisper.cpp/models/ggml-base.en.bin -f {input} -ovtt -of {output} -np"
#
# Option B: any OpenAI-compatible /audio/transcriptions endpoint. With OpenAI
# itself, the audio is sent to OpenAI; a self-hosted server keeps it local.
# TRANSCRIBE_PROVIDER=openai
# TRANSCRIBE_API_URL=https://api.openai.com/v1
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-1
# TRANSCRIBE_LANGUAGE=en

# --- Consent ledger --------------------------------------------------------------
# Every submission records the exact consent wording (versioned) and scopes.
# Set to "true" to also store a keyed hash of the submitter's IP address with
# each consent record (it can't be reversed without SESSION_SECRET).
# CONSENT_IP_HASH=false

# --- Email (request links, reminders, receipts) ----------------------------------
# Your own SMTP server; nothing is sent without it. Step by step, with exact
# settings for Gmail, Microsoft 365, Resend, SES and others: docs/EMAIL.md
#   SMTP_URL=smtps://user:password@smtp.example.com:465
#   SMTP_URL=smtp://user:password@smtp.example.com:587   (STARTTLS)
# URL-encode special characters in the user and password (@ becomes %40).
# SMTP_URL=
# Or in parts, with the password as is (SMTP_URL wins if both are set):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# SMTP_SECURE=true          # implied by port 465; false for 587/25/2525
# Who the mail is from. Must be an address your provider lets you send as;
# without it mail comes from no-reply@localhost, which real servers refuse.
# SMTP_FROM="Acme <hello@acme.example>"
# For trying things out: write emails to DATA_DIR/mail-outbox instead of sending.
# MAIL_OUTBOX=true

# --- Import / export -------------------------------------------------------------
# Largest export archive accepted when importing a project (megabytes).
# MAX_IMPORT_MB=10240
# CSV imports can download videos/photos from URLs in the file. Private-network
# addresses (localhost, 10.x, 192.168.x …) are refused unless this is true.
# IMPORT_ALLOW_PRIVATE_URLS=false
