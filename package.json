{
  "name": "plaudit",
  "version": "0.2.0",
  "private": true,
  "description": "Plaudit: free, open-source, self-hostable video + text testimonial collection",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations.mjs && node scripts/check-schema-drift.mjs",
    "check:ownership": "node scripts/check-ownership.mjs",
    "check:req": "node scripts/req-coverage.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "htmlparser2": "12.0.0",
    "jose": "6.2.12",
    "lucide-react": "1.65.0",
    "next": "^16.4.2",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "3.5.13",
    "drizzle-kit": "^0.31.11",
    "jsdom": "30.1.1",
    "smtp-server": "3.19.16",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
